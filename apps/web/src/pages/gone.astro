---
// What a retired old URL shows (R16): the server wrapper answers it 410 Gone
// and renders this page in the site's own layout.
import Base from '../layouts/Base.astro';

Astro.response.status = 410;
const title = 'This page is no longer here';
---
<Base path="/gone" title={title} description="This page from the old site has been retired.">
  <h1>{title}</h1>
  <p class="lead">It came from the old site and has been retired.</p>
  <p><a href="/more">See every part of the site</a></p>
</Base>
