---
// News: Pensa Mensa, the newsletter. The current issue, then every other issue
// by year (R5), on request. From the API when it is set (W3): the issues the
// issue loader published, each with its public PDF. Until the API has one, and
// without the API, the bundled sample, which says it is one; its missing issues
// are listed honestly. Large-type reading views arrive with the archive (MB3).
// PDFVIEW: each issue opens in the site (/read/<id>), with a small "PDF file" link to the
// file itself. Once, above the issue list, the notice that these are the public copies (CopyNotice):
// "sign in" is a link where sign-in works for a signed-out reader (membersSignInLink), and plain
// words otherwise; a member's view, which has the members copies, shows instead the line not to
// forward them, by each; and in it an issue with a public copy only says "Public copy only" in its own row or card.
// S2: with that line, or the one to sign in again, the page says once which password to use.
// A14: read with a signed-in reader's token (src/lib/auth/bearer.ts), the page
// shows what the API sent that reader: a member gets each issue's members copy
// and the newsletter's members articles and passages. A lapsed token gives the
// public view and a line to sign in again (an enrolee's session only: one with
// no nwfl enrolee group is told it has no member access); a token the API refuses, the public
// view and a line to ask for help, since signing in again would be refused too.
// The articles section appears only once one is published, so the public page
// is unchanged till then. Articles the API cannot give a signed-in reader leave
// the issues listed, with a line saying so in their place and a 503, as Home
// does for one section; for the public, the page is as it was before articles.
import { PUBLIC_ONLY } from 'astro:env/server';
import IssueCard from '../components/IssueCard.astro';
import ItemFiles from '../components/ItemFiles.astro';
import CopyNotice from '../components/CopyNotice.astro';
import PasswordNote from '../components/PasswordNote.astro';
import SampleNotice from '../components/SampleNotice.astro';
import Unavailable from '../components/Unavailable.astro';
import { liveData, siteData } from '../data';
import { formatDate } from '../data/format';
import { currentIssue, issueSummary, issuesByYear, newsIssues } from '../data/site-data';
import Base from '../layouts/Base.astro';
import { attempt, markUnavailable } from '../lib/api/page';
import { membersSignInLink, readerFor, signInLink } from '../lib/auth/bearer';
import { runtimeDeps } from '../lib/auth/flow';
import { visibleContent } from '../lib/content';
import { MEMBERS_RULE } from '../lib/document';
import { PUBLIC_COPY_ONLY, readerPath } from '../lib/reader';
import { page } from '../lib/site';

const p = page('/news');
const live = liveData();
const auth = runtimeDeps();
const { reader, lapsed } = readerFor(Astro.locals.session, auth);
const signIn = signInLink(auth, PUBLIC_ONLY, '/news');
// Where a signed-out reader's notice says to sign in: the same for all of them.
const membersSignIn = membersSignInLink(Astro.locals.session, auth, PUBLIC_ONLY, '/news');
const loaded = live ? await attempt(() => live.news(reader, { signIn })) : { ok: true as const, value: undefined };
const news = loaded.ok ? loaded.value : undefined;
if (!loaded.ok || news?.itemsUnavailable) markUnavailable(Astro.response);
const shown = newsIssues(news?.issues ?? [], visibleContent(await siteData.issues(), { publicOnly: PUBLIC_ONLY }));
const current = currentIssue(shown.issues);
const past = issuesByYear(shown.issues);
// A reader with no members copy on any issue listed gets the notice, once, above them all. One who has a
// members copy on at least one (a member's view) gets none; an issue there with a public copy only says so itself.
const noMembersCopy = !shown.issues.some((i) => i.membersPdf);
const publicCopies = noMembersCopy && shown.issues.some((i) => i.pdf);
const alone = (i: { pdf?: string; membersPdf?: string }) => !noMembersCopy && !!i.pdf && !i.membersPdf;
const items = news?.items ?? [];
---
<Base {...p}>
  <h1>{p.title}</h1>
  <p class="lead">Pensa Mensa, our newsletter: {p.description.charAt(0).toLowerCase()}{p.description.slice(1)}</p>
  {lapsed && <p class="notice" role="note">Your sign-in has expired for members-only reading. {signIn ? <a href={signIn}>Sign in again</a> : 'Sign in again'}.</p>}
  {(membersSignIn || (lapsed && signIn)) && <PasswordNote />}
  {news?.tokenRefused && <p class="notice" role="note">Members-only reading is not available for this sign-in. <a href="/help">Ask for help</a>.</p>}
  {!loaded.ok ? <Unavailable what="The list of issues" /> : (
    <>
      {shown.sample && siteData.isSample && <SampleNotice />}
      {publicCopies && <CopyNotice signIn={membersSignIn} />}
      {current && <IssueCard issue={current} publicOnly={alone(current)} />}
      <section aria-labelledby="past-title">
        <h2 id="past-title">Past issues</h2>
        {past.map(([year, list]) => (
          <div class="yr">
            <h3>{year}</h3>
            <ul class="issues">
              {list.map((i) => (
                <li data-source={i.source} class={i.missing ? 'missing' : undefined}>
                  {i.pdf ? <a href={readerPath(i.pdf)}>{i.label}</a> : <span>{i.label}</span>}
                  {i.membersPdf && <a href={readerPath(i.membersPdf)}>{i.label}, members copy</a>}
                  {i.pdf && (
                    <span class="pdf-files">
                      <a href={i.pdf}>PDF file<span class="visually-hidden"> of {i.label}</span></a>
                      {i.membersPdf && <a href={i.membersPdf}>Members PDF file<span class="visually-hidden"> of {i.label}</span></a>}
                    </span>
                  )}
                  {i.missing ? <span class="muted">No copy known. If you have a paper copy, please tell the Editor.</span>
                    : issueSummary(i) && <span class="muted">{issueSummary(i)}</span>}
                  {alone(i) && <span class="muted">{PUBLIC_COPY_ONLY}</span>}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </section>
      {news?.itemsUnavailable && <Unavailable what="The list of articles" />}
      {items.length > 0 && (
        <section class="articles" aria-labelledby="articles-title">
          <h2 id="articles-title">From the newsletter</h2>
          {items.map((a) => (
            <article class="item" data-source={a.source}>
              <h3>{a.title}</h3>
              {a.membersOnly && !a.teaser && <p class="members-rule">{MEMBERS_RULE}</p>}
              {a.publishedOn && <p class="muted">{formatDate(a.publishedOn)}</p>}
              {a.summary && <p>{a.summary}</p>}
              <div class="prose" set:html={a.bodyHtml} />
              <ItemFiles files={a.files} />
            </article>
          ))}
        </section>
      )}
    </>
  )}
  <p><a href="/search">Search the newsletter archive</a></p>
</Base>
