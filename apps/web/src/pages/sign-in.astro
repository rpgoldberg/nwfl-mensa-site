---
// Sign in (W4): starts the authorization code flow at the club's sign-in
// provider, and comes back to the page the reader was on. Someone already
// signed in goes straight back, unless they ask again (again=1: a fresh token,
// A14). If sign-in is not set up, or the provider cannot be reached, the
// reader is told so in plain words, and which password to use. S2: asked for
// on another host (in production, any but the profile's), it starts on the
// profile's origin, where the host-only session cookie lives (beginSignIn),
// never stored. A working sign-in shows no page here, so the same note goes
// on the provider's own password page (fc's side).
import PasswordNote from '../components/PasswordNote.astro';
import Base from '../layouts/Base.astro';
import { beginSignIn, runtimeDeps } from '../lib/auth/flow';
import { page } from '../lib/site';

const out = await beginSignIn(runtimeDeps(), {
  cookieHeader: Astro.request.headers.get('cookie'),
  back: Astro.url.searchParams.get('return'),
  again: Astro.url.searchParams.get('again') === '1',
  host: Astro.request.headers.get('host'),
});
if (out.kind === 'redirect') {
  const headers = new Headers({ Location: out.location });
  if (out.cache) headers.set('Cache-Control', out.cache);
  for (const cookie of out.cookies) headers.append('Set-Cookie', cookie);
  return new Response(null, { status: 303, headers });
}
Astro.response.status = 503;
const p = page('/sign-in');
---
<Base {...p}>
  <h1>{p.title}</h1>
  <p class="lead">Signing in is not available just now. Please try again later; if it keeps happening, ask any of our officers.</p>
  <PasswordNote />
</Base>
