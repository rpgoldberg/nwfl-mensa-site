---
// LINKS L4 (SPEC D3a): the leaving page. A link in our PDF copies points here by an opaque id,
// never by its URL; the API says where it leads for this reader now (GetLinkTarget, read with the
// reader's token as the PDF route reads the file), and src/lib/out.ts checks the answer again and
// decides, with the reader's "next time" choice (__Host-nwfl-links), whether to show this page, show
// it and count down (public/scripts/out.js), or answer 303 to the URL. On request, never stored, no
// referrer (server/policy.mjs), not for search engines (noindex, robots.txt). Every id the API has
// no link for, for this reader, is the same 404.
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Unavailable from '../../components/Unavailable.astro';
import { liveData } from '../../data';
import { attempt, markUnavailable } from '../../lib/api/page';
import { readerFor } from '../../lib/auth/bearer';
import { runtimeDeps } from '../../lib/auth/flow';
import { LINK_ID, outView } from '../../lib/out';
import { readPrefs } from '../../../server/prefs.mjs';

export const prerender = false;

const id = Astro.params['id'] ?? '';
const live = liveData();
const mode = readPrefs(Astro.request.headers.get('cookie')).links ?? 'guard';
const saved = Astro.url.searchParams.get('saved') === '1';
const loaded = live === undefined || !LINK_ID.test(id) ? { ok: true as const, value: { kind: 'not_found' as const } } : await attempt(() => live.link(id, readerFor(Astro.locals.session, runtimeDeps()).reader));
const view = loaded.ok ? outView(loaded.value, mode, { saved }) : undefined;
if (view?.kind === 'redirect') return new Response(null, { status: 303, headers: { Location: view.location, 'Cache-Control': 'private, no-store', 'Referrer-Policy': 'no-referrer' } });
if (!loaded.ok) markUnavailable(Astro.response);
if (view?.kind === 'not_found') Astro.response.status = 404;
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');

const CHOICES = [
  { value: 'guard', label: 'Show me this page, and wait until I choose Continue' },
  { value: 'countdown', label: 'Show me this page, then continue after 5 seconds unless I press Stop' },
  { value: 'direct', label: 'Go straight to the other site' },
] as const;
const SAVED_TEXT = { guard: 'we will show you this page and wait', countdown: 'we will show you this page, then continue after 5 seconds', direct: 'we will take you straight there' } as const;
const title = view?.kind === 'not_found' ? 'This link is not available' : view?.kind === 'disabled' ? 'This link was turned off' : 'You are leaving the Northwest Florida Mensa site';
---
<Base path={Astro.url.pathname} title={title} description="Before you go to another site from our newsletter." noindex>
  <h1>{title}</h1>
  {!view && <Unavailable what="This link" />}
  {view?.kind === 'not_found' && (
    <>
      <p>There is no link at this address, or it is no longer in the newsletter you opened. Open the newsletter again from the News page to get its current links.</p>
      <p class="btns"><a class="button" href="/news">Go to the News page</a></p>
    </>
  )}
  {view?.kind === 'disabled' && (
    <>
      <p class="out-off">This link was turned off{view.date ? ` on ${view.date}` : ''} because the site it led to has changed. We no longer send readers there.</p>
      <p class="btns"><a class="button" href={view.back}>Back to the newsletter</a></p>
    </>
  )}
  {view?.kind === 'leave' && (
    <>
      {view.saved && <p class="notice" role="status">Saved. Next time you follow a link to another site, {SAVED_TEXT[view.mode]}.</p>}
      <p class="out-lead">{view.mail ? 'This link writes an email to an address at' : 'This link goes to'}</p>
      <p class="out-host">{view.host}</p>
      <p class="out-url">{view.url}</p>
      {view.checked && <p>We last checked this link on {view.checked}.</p>}
      {view.loginWalled && <p class="notice" role="note">This page is on {view.loginWalled}. You may need to sign in to {view.loginWalled} to see it.</p>}
      <p class="out-status" role="status" data-out-status></p>
      {view.countdown && (
        <div class="out-countdown" data-out-countdown data-host={view.host} hidden>
          <p class="out-count" aria-hidden="true">Continuing in <span data-out-seconds>5</span> seconds.</p>
          <button class="button out-stop" type="button" data-out-stop>Stop</button>
        </div>
      )}
      <p class="btns out-go">
        {view.mail ? (
          <a class="button" href={view.url} data-out-continue><Icon name="external" />Write an email to {view.address}</a>
        ) : (
          <a class="button" href={view.url} target="_blank" rel="noopener noreferrer" data-out-continue><Icon name="external" /><span>Continue to {view.host} <span class="out-newtab">(opens in a new tab)</span></span></a>
        )}
        <a class="button button--secondary" href={view.back}>Back to the newsletter</a>
      </p>
    </>
  )}
  {(view?.kind === 'leave' || view?.kind === 'disabled') && (
    <form class="rule-form out-next" method="post" action="/prefs">
      <input type="hidden" name="back" value={`/out/${id}?saved=1`} />
      <fieldset>
        <legend>Next time I follow a link to another site</legend>
        {CHOICES.map((choice) => (
          <div class="choice">
            <input type="radio" id={`links-${choice.value}`} name="links" value={choice.value} checked={view.mode === choice.value} />
            <label for={`links-${choice.value}`}>{choice.label}</label>
          </div>
        ))}
      </fieldset>
      <p class="hint">Saved on this device only. Email links always show this page. You can change this at any time under Aa, at the top of every page.</p>
      <p><button class="button button--secondary" type="submit">Save my choice</button></p>
    </form>
  )}
  {view?.kind === 'leave' && view.countdown && <script is:inline type="module" src="/scripts/out.js"></script>}
</Base>
