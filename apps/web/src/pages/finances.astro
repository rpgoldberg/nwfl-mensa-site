---
// The treasurer's summary per period, totals only (R7), on request, once the
// Executive Committee has accepted it.
import { PUBLIC_ONLY } from 'astro:env/server';
import PublicOnlyNote from '../components/PublicOnlyNote.astro';
import SampleNotice from '../components/SampleNotice.astro';
import { siteData } from '../data';
import { formatDate, formatMoney } from '../data/format';
import { balanced } from '../data/site-data';
import Base from '../layouts/Base.astro';
import { visibleContent } from '../lib/content';
import { page } from '../lib/site';

const p = page('/finances');
const periods = visibleContent(await siteData.finances(), { publicOnly: PUBLIC_ONLY });
---
<Base {...p}>
  <h1>{p.title}</h1>
  <p class="lead">{p.description} The same figures appear in the newsletter and in the Executive Committee's minutes.</p>
  {siteData.isSample && <SampleNotice />}
  {PUBLIC_ONLY ? <PublicOnlyNote what="The treasurer's summary" /> : periods.map((period) => (
    <section class="finance" data-source={period.source}>
      <div class="table-wrap" role="region" aria-label={`Figures for ${period.label}`} tabindex="0">
      {/* Explicit roles: on a narrow phone the rows stack (site.css), and display: block can drop a table's.
          jsx-a11y counts a td as interactive (a grid cell); here it is a plain cell. */}
      <table class="money" role="table">
        <caption>{period.label}</caption>
        <tbody>
          {/* eslint-disable astro/jsx-a11y/no-interactive-element-to-noninteractive-role */}
          <tr role="row"><th scope="row" role="rowheader">Opening balance</th><td role="cell">{formatMoney(period.opening)}</td></tr>
          <tr role="row"><th scope="row" role="rowheader">Deposits</th><td role="cell">{formatMoney(period.deposits)}</td></tr>
          <tr role="row"><th scope="row" role="rowheader">Debits</th><td role="cell">{formatMoney(-period.debits)}</td></tr>
          <tr role="row" class="total"><th scope="row" role="rowheader">Closing balance</th><td role="cell">{formatMoney(period.closing)}</td></tr>
          {/* eslint-enable astro/jsx-a11y/no-interactive-element-to-noninteractive-role */}
        </tbody>
      </table>
      </div>
      {!balanced(period) && <p class="notice" role="note">These totals do not add up; the Treasurer will correct them.</p>}
      <p class="muted">Accepted by the Executive Committee on {formatDate(period.acceptedOn)}.</p>
    </section>
  ))}
</Base>
