---
// W-SIGNUP D4: the approvers' queue. The pending sign-ups, oldest first, one card each: the name and
// email from the person's sign-in account, what they typed (PROFILE-ID: first name, last name and
// membership number), how they came (invited by an officer, or signed up on the site), and the
// membership check's outcome and day. A duplicate claim also shows what the earlier claim typed, so the
// approver can compare (none for a claim since closed, VET fix 1). Approve, or Reject after a
// confirmation step (only the Admin or the Membership Officer can reopen it, below). No one decides
// their own sign-up: the API refuses it, and the page says so. A sign-up the
// check found in another local group is not approved as a member (R33): it has no Approve button,
// and the API refuses it too. Each decision goes to the API with the approver's own token
// (src/lib/api/membership.ts), which alone decides who may.
//
// VET: an email the membership verification service did not confirm, or a number another account
// already claimed, never approves by itself. Its card says in words what to do first (checkWarning:
// confirm with the member, or wait for an officer, naming the earlier claim), labelled "Before approving"
// in text, not by colour, and the Approve button is described by it as well as by the name.
// VET fix 1: approving either one also needs a box ticked next to the warning, labelled for its
// outcome (confirmText: confirmed with the member, or resolved the earlier claim). The box is the
// Approve form's own (its form attribute), required, and sent as confirmed_warning; the API refuses
// the approval without it, and the page then says the box was not ticked (decisionRefusal).
//
// REOPEN: the Admin and the Membership Officer (the nwfl-office-membership seat; not every approver)
// also see the rejected sign-ups that can still be reopened, newest first, each with a Reopen button
// and a confirmation step, so a mistaken rejection can be fixed, each with what the person typed.
// Reopening lets the person send the sign-up form again from /account. The list and the button are shown only
// to those the API would allow (isSignupReopener); the API decides again on every call.
//
// The Membership Officer's seat without the approvers group sees the rejections alone: no queue, which
// the API would not list for them, under its own title (signUpsTitle, the officer area's link words).
// An approve or reject they post anyway is refused in words that fit them (refusedText), and a
// malformed post still shows the list it points to. The API lists the latest 50 rejections, with no
// paging; a full list says so (rejectedShownNote), so none is hidden without a word.
//
// QUEUE-C: each card is compact, the same words on a shorter page: the name with the email under it,
// then the details as label and value pairs (dl, dt and dd) in a grid (pendingFacts, rejectedFacts), two
// to a row on a phone, up to four on a desktop; the membership check's sentence across the card; the
// warnings whole; the box to tick and the buttons on one row where they fit (src/styles/site.css).
//
// Not signed in: sign in first. Signed in but neither a membership approver, the Admin nor the
// Membership Officer: the plain
// not-found page, as for the approval setting, and it is never linked for them. It works with no
// script: each step is a form post, answered with a page or a 303 back here. Astro's origin check
// refuses a cross-site post first; the body is capped and must be a form (src/lib/form.ts).
import PasswordNote from '../../components/PasswordNote.astro';
import Unavailable from '../../components/Unavailable.astro';
import Base from '../../layouts/Base.astro';
import { DecisionRefused, MembershipSignInAgain, type PendingSignup, type RejectedSignup, membershipApi, sessionReader } from '../../lib/api/membership';
import { markUnavailable, signInFirst } from '../../lib/api/page';
import { runtimeDeps } from '../../lib/auth/flow';
import { readForm } from '../../lib/form';
import {
  DECISION_REFUSED,
  type DecisionForm,
  checkText,
  checkWarning,
  confirmText,
  decisionRefusal,
  doneFromQuery,
  doneText,
  isMembershipApprover,
  isSignupReopener,
  parseDecisionForm,
  pendingFacts,
  refusedText,
  rejectedFacts,
  rejectedShownNote,
  signUpsTitle,
  typedFacts,
} from '../../lib/signup';
import { page } from '../../lib/site';

export const prerender = false;

const HERE = '/officer-area/sign-ups';
const SIGN_IN = `/sign-in?return=${encodeURIComponent(HERE)}`;
/** Three short fields. */
const MAX_FORM_BYTES = 4 * 1024;

const session = Astro.locals.session;
// Never stored by a shared cache (fix 1, src/lib/api/page.ts signInFirst).
if (!session) return signInFirst(SIGN_IN);
const approver = isMembershipApprover(session);
const reopener = isSignupReopener(session);
if (!approver && !reopener) return Astro.rewrite('/404');
const p = { ...page(HERE), title: signUpsTitle(session) };
const api = membershipApi();
const { reader } = sessionReader(session, runtimeDeps());
Astro.response.headers.set('Cache-Control', 'private, no-store');

let confirming: DecisionForm | undefined;
/** A decision the API refused, with its form: VET fix 1 tells a missing confirmation from a closed sign-up once the queue is read. */
let refusedBy: { reason: 'own' | 'closed'; form: DecisionForm } | undefined;
let problem: 'sign-in' | 'unavailable' | 'form' | undefined;

if (Astro.request.method === 'POST') {
  const read = await readForm(Astro.request, MAX_FORM_BYTES);
  if (!read.ok) return new Response(read.status === 413 ? 'Too large.' : 'Send the form.', { status: read.status, headers: read.status === 413 ? { Connection: 'close' } : {} });
  const parsed = parseDecisionForm(read.field);
  if (!parsed.ok) {
    problem = 'form';
    Astro.response.status = 400;
  } else if (parsed.value.decision !== 'approve' && !parsed.value.confirmed) {
    confirming = parsed.value;
  } else if (api === undefined) {
    problem = 'unavailable';
  } else if (reader === undefined) {
    problem = 'sign-in';
  } else {
    try {
      const { decision, requestId } = parsed.value;
      if (decision === 'approve') await api.approveSignup(reader, requestId, { confirmedWarning: parsed.value.confirmed });
      else if (decision === 'reject') await api.rejectSignup(reader, requestId);
      else await api.reopenSignup(reader, requestId);
      return Astro.redirect(`${HERE}?done=${decision === 'approve' ? 'approved' : decision === 'reject' ? 'rejected' : 'reopened'}`, 303);
    } catch (error) {
      if (error instanceof DecisionRefused) {
        refusedBy = { reason: error.reason, form: parsed.value };
        Astro.response.status = 409;
      } else {
        problem = error instanceof MembershipSignInAgain ? 'sign-in' : 'unavailable';
      }
    }
  }
}

let requests: PendingSignup[] | undefined;
let rejected: RejectedSignup[] | undefined;
let rejectedUnavailable = false;
if (api !== undefined && reader !== undefined) {
  if (approver) {
    try {
      requests = await api.listSignupRequests(reader);
    } catch (error) {
      problem ??= error instanceof MembershipSignInAgain ? 'sign-in' : 'unavailable';
    }
  }
  // The queue stands on its own: a list of rejections that cannot be read says so in its place.
  if (reopener && (problem === undefined || problem === 'form')) {
    try {
      rejected = await api.listRejectedSignups(reader);
    } catch (error) {
      // A refused token says to sign in again, as for the queue.
      if (error instanceof MembershipSignInAgain) problem = 'sign-in';
      else rejectedUnavailable = true;
    }
  }
} else {
  problem ??= api === undefined ? 'unavailable' : 'sign-in';
}
if (problem === 'unavailable') markUnavailable(Astro.response);
const refused: { reason: keyof typeof DECISION_REFUSED; reopen: boolean } | undefined =
  refusedBy && { reason: decisionRefusal(refusedBy.reason, refusedBy.form, requests), reopen: refusedBy.form.decision === 'reopen' };

const done = Astro.request.method === 'GET' ? doneFromQuery(Astro.url.searchParams) : undefined;
const confirmed = confirming?.decision === 'reject' ? requests?.find((r) => r.requestId === confirming.requestId) : undefined;
const reopening = confirming?.decision === 'reopen' ? rejected?.find((r) => r.requestId === confirming.requestId) : undefined;
---
<Base {...p}>
  <h1>{p.title}</h1>
  {approver ? (
    <p class="lead">People who signed up and are waiting for member access. Approve a sign-up to give the account member access, or reject it.</p>
  ) : (
    <p class="lead">Sign-ups that were rejected and can be reopened.</p>
  )}
  {done && <p class="notice" role="status">{doneText(done)}</p>}
  {refused && <p class="notice" role="alert">{refusedText(refused, approver)}</p>}
  {problem === 'form' && <p class="notice" role="alert">Nothing was changed: send the form again from the list below.</p>}
  {problem === 'sign-in' && <p class="notice" role="note">Your sign-in has run out for this page. <a href={`${SIGN_IN}&again=1`}>Sign in again</a>, then try again.</p>}
  {problem === 'sign-in' && <PasswordNote />}
  {problem === 'unavailable' && <Unavailable what="The sign-up list" />}

  {reopening ? (
    <section class="card" aria-labelledby="confirm-title">
      <h2 id="confirm-title">Reopen this sign-up?</h2>
      <p>{reopening.displayName} ({reopening.email}).</p>
      <p><b>The person will be able to send the sign-up form again from their account page. The rejection stays in the records.</b></p>
      <form method="post" action={HERE}>
        <input type="hidden" name="decision" value="reopen" />
        <input type="hidden" name="request" value={reopening.requestId} />
        <input type="hidden" name="confirmed" value="yes" />
        <div class="btns">
          <button class="button" type="submit">Yes, reopen it</button>
          <a class="button button--secondary" href={HERE}>Cancel</a>
        </div>
      </form>
    </section>
  ) : confirmed ? (
    <section class="card" aria-labelledby="confirm-title">
      <h2 id="confirm-title">Reject this sign-up?</h2>
      <p>{confirmed.displayName} ({confirmed.email}).</p>
      <p><b>A rejected sign-up is removed from the queue. Only the Admin or the Membership Officer can reopen it, so the person can sign up again.</b></p>
      <form method="post" action={HERE}>
        <input type="hidden" name="decision" value="reject" />
        <input type="hidden" name="request" value={confirmed.requestId} />
        <input type="hidden" name="confirmed" value="yes" />
        <div class="btns">
          <button class="button" type="submit">Yes, reject it</button>
          <a class="button button--secondary" href={HERE}>Cancel</a>
        </div>
      </form>
    </section>
  ) : requests !== undefined && (
    requests.length === 0 ? (
      <p class="card empty">No sign-ups are waiting.</p>
    ) : (
      <>
        <p>{requests.length === 1 ? 'One sign-up is waiting.' : `${requests.length} sign-ups are waiting.`}</p>
        {requests.map((r, i) => { const warning = checkWarning(r); const confirm = confirmText(r.verification); return (
          <section class="card signup-card" aria-labelledby={`signup-${i}`}>
            <div class="signup-who">
              <h2 id={`signup-${i}`}>{r.displayName}</h2>
              <p>{r.email}</p>
            </div>
            <dl class="facts facts--grid">
              {pendingFacts(r).map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
              <div class="facts__wide"><dt>Membership check</dt><dd>{checkText(r.verification, r.verifiedOn)}</dd></div>
            </dl>
            {r.verification === 'verified_other_group' && (
              <p>This person is a member of another local group, so the sign-up cannot be approved as a member here. Reject it, or ask the Admin or the Webmaster about affiliate access.</p>
            )}
            {warning && <p class="notice" role="note" id={`signup-warning-${i}`}><strong>Before approving:</strong> {warning}</p>}
            {r.earlierClaim && !r.earlierClaim.closed && typedFacts(r.earlierClaim).length > 0 && (
              <section class="earlier-claim" aria-labelledby={`signup-earlier-${i}`}>
                <h3 id={`signup-earlier-${i}`}>The earlier claim{r.earlierClaim.displayName ? ` (${r.earlierClaim.displayName})` : ''}</h3>
                <dl class="facts facts--grid">
                  {typedFacts(r.earlierClaim).map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
                </dl>
              </section>
            )}
            <div class="signup-decide">
              {confirm && (
                <div class="choice confirm-warning">
                  <input type="checkbox" id={`signup-confirm-${i}`} form={`signup-approve-${i}`} name="confirmed" value="yes" required aria-describedby={`signup-warning-${i}`} />
                  <label for={`signup-confirm-${i}`}>{confirm}</label>
                </div>
              )}
              <div class="btns">
                {r.verification !== 'verified_other_group' && (
                  <form method="post" action={HERE} id={`signup-approve-${i}`}>
                    <input type="hidden" name="decision" value="approve" />
                    <input type="hidden" name="request" value={r.requestId} />
                    <button class="button" type="submit" aria-describedby={warning ? `signup-${i} signup-warning-${i}` : `signup-${i}`}>Approve</button>
                  </form>
                )}
                <form method="post" action={HERE}>
                  <input type="hidden" name="decision" value="reject" />
                  <input type="hidden" name="request" value={r.requestId} />
                  <button class="button button--secondary" type="submit" aria-describedby={`signup-${i}`}>Reject</button>
                </form>
              </div>
            </div>
          </section>
        ); })}
      </>
    )
  )}

  {!confirmed && !reopening && rejectedUnavailable && (
    <p class="notice" role="note">The rejected sign-ups cannot be shown just now. Try again in a few minutes.</p>
  )}
  {!confirmed && !reopening && rejected !== undefined && (
    <section aria-labelledby="rejected-title">
      <h2 id="rejected-title">Rejected sign-ups</h2>
      <p>Rejected by mistake? Reopen a sign-up so the person can send the form again. Only the Admin and the Membership Officer see this list.</p>
      {rejectedShownNote(rejected.length) && <p role="note">{rejectedShownNote(rejected.length)}</p>}
      {rejected.length === 0 ? (
        <p class="card empty">No rejected sign-ups can be reopened.</p>
      ) : (
        rejected.map((r, i) => (
          <section class="card rejected-card" aria-labelledby={`rejected-${i}`}>
            <div class="signup-who">
              <h3 id={`rejected-${i}`}>{r.displayName}</h3>
              <p>{r.email}</p>
            </div>
            <dl class="facts facts--grid">
              {rejectedFacts(r).map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
              <div class="facts__wide"><dt>Membership check</dt><dd>{checkText(r.verification, r.verifiedOn)}</dd></div>
            </dl>
            <form method="post" action={HERE}>
              <input type="hidden" name="decision" value="reopen" />
              <input type="hidden" name="request" value={r.requestId} />
              <div class="btns">
                <button class="button button--secondary" type="submit" aria-describedby={`rejected-${i}`}>Reopen</button>
              </div>
            </form>
          </section>
        ))
      )}
    </section>
  )}
  <p><a href="/officer-area">Back to the officer area</a></p>
</Base>
