---
// The officer area (W5 fills it in). It admits the officers, the Admin, the Webmaster and the
// membership approvers (server/account.mjs officerAreaFor, which the header's link follows too; W-SIGNUP
// fix 1): anyone not signed in is sent to sign in first; anyone else signed in is told it is not
// theirs (403). Each person sees only the links for what they may do: the approval setting for the
// Admin alone (whether or not in the officers group: the switch serves them); the sign-ups waiting
// for approval for the membership approvers and the Admin (W-SIGNUP D4), and the rejections alone for
// the Membership Officer's seat without the approvers group (REOPEN).
// SOLO-APPROVE: an officer sees the one-approver note here while the Admin has set a scope to one
// approver (read from the API with the officer's own token, src/lib/api/officer.ts), and a plain line
// when it could not be read, with Sign in again and the password note (S2) when the sign-in ran out.
// Nothing here reaches a member who is none of these, or the public.
// EDITOR E3 (S1): "Write news" for everyone the editor admits (an officer, the Admin, the Webmaster).
// "Our events" joins it with E6's pages (writer.ts OUR_EVENTS), so it never leads to a missing page.
// EDITOR E4 (SPEC-v3 2.4): "Approve news (N waiting)" for every reviewer, and the counts in words: "N
// pieces wait for your approval" (never what they changed) and, for the Webmaster and the Admin, "N pieces
// are approved and ready to publish". Read with the person's own token; unread, the link stays and the
// counts are left out.
import { officerAreaFor } from '../../../server/account.mjs';
import OneApproverNote from '../../components/OneApproverNote.astro';
import PasswordNote from '../../components/PasswordNote.astro';
import Base from '../../layouts/Base.astro';
import { type Setting, isAdmin, notesFor } from '../../lib/approval-rules';
import { type EditorItem, editorAdmits, editorApi, editorReader } from '../../lib/api/editor';
import { OfficerSignInAgain, officerApi, officerReader } from '../../lib/api/officer';
import { runtimeDeps } from '../../lib/auth/flow';
import { mayUseEvents } from '../../lib/editor/events';
import { REVIEW_LINKS, homeCounts, homeLines, isPublisher } from '../../lib/editor/review';
import { EDIT_LINKS, OUR_EVENTS } from '../../lib/editor/writer';
import { signUpsLink } from '../../lib/signup';
import { page } from '../../lib/site';

const session = Astro.locals.session;
if (!session) return Astro.redirect('/sign-in?return=%2Fofficer-area', 303);
const admitted = officerAreaFor(session);
const admin = isAdmin(session);
const signUps = signUpsLink(session);
// E4: what waits for this reviewer, read with their own token; unread (no token, or the API down), no counts.
let queue: EditorItem[] | undefined;
const editor = editorAdmits(session) ? editorApi() : undefined;
const reviewer = editor ? editorReader(session, runtimeDeps()).reader : undefined;
if (editor && reviewer) queue = await editor.listWorkingItems(reviewer, { versionStatuses: ['ready', 'cleared'] }).catch(() => undefined);
const counts = queue === undefined ? undefined : homeCounts(queue);
const links = [
  ...(editorAdmits(session) ? [{ href: EDIT_LINKS.list, text: 'Write news' }] : []),
  ...(editorAdmits(session) ? [{ href: REVIEW_LINKS.queue, text: counts === undefined ? 'Approve news' : `Approve news (${counts.toApprove} waiting)` }] : []),
  // E6: only for whom the events pages admit (an officer or the Admin), never a link to a page that turns them away.
  ...(mayUseEvents(session.groups) && OUR_EVENTS !== undefined ? [{ href: OUR_EVENTS, text: 'Our events' }] : []),
  ...(signUps !== undefined ? [{ href: '/officer-area/sign-ups', text: signUps }] : []),
  ...(admin ? [{ href: '/officer-area/approval-rules', text: 'Approval setting' }] : []),
];
if (!admitted) Astro.response.status = 403;
const p = page('/officer-area');

let notes: string[] = [];
let signIn: string | undefined;
if (session.officer) {
  const api = officerApi();
  const { reader, lapsed } = officerReader(session, runtimeDeps());
  let settings: Setting[] | undefined;
  let refused = false;
  if (api && reader) {
    try {
      settings = await api.getApprovalRules(reader);
    } catch (error) {
      // Unavailable, or the token was refused: the note says it could not check.
      refused = error instanceof OfficerSignInAgain;
    }
  }
  notes = notesFor(settings);
  if (settings === undefined && (lapsed || refused)) signIn = '/sign-in?return=%2Fofficer-area&again=1';
}
const lead = session.officer
  ? 'Write news for your office, and approve what other officers wrote.'
  : admin
    ? 'As the Admin, you can change the approval setting here.'
    : links.length === 0
      ? 'The approval queue comes here in the next update.'
      : '';
---
<Base {...p}>
  <h1>{p.title}</h1>
  {admitted
    ? <>
        <p class="lead">Welcome, {session.name}.{lead && ` ${lead}`}</p>
        {session.officer && <OneApproverNote notes={notes} signIn={signIn} />}
        {session.officer && signIn && <PasswordNote />}
        {counts && (
          <ul class="review-counts" aria-label="Waiting for you">
            {homeLines(counts, isPublisher(session.groups)).map((text) => <li>{text}</li>)}
          </ul>
        )}
        {links.length > 0 && (
          <ul class="link-list">
            {links.map((link) => <li><a href={link.href}>{link.text}</a></li>)}
          </ul>
        )}
      </>
    : <p class="lead">This area is for the club's officers. If you are an officer and see this, ask the Webmaster to check your account.</p>}
</Base>
