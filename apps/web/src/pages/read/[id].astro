---
// PDFVIEW: an issue read inside the site. The copy is whichever /documents/<id>.pdf gives this reader
// (the browser fetches it with the reader's cookies, src/lib/files.ts): the page says which
// (src/lib/reader.ts), and is cached as that file is: by the reader's browser only, briefly, for the
// public copy, and never stored for a signed-in reader (server/policy.mjs, and here). A file the reader may
// not have is the same 404 as a missing one. public/scripts/viewer.js draws it with pdf.js's core API
// (the legacy build, for older phones and tablets); never pdf.js's viewer.html, and never an address
// from the query. Open in another app hands the same file to the device's own viewer; Download asks
// for it as an attachment; both are links in the bar on the frame's top edge (W-LOOK3, Ross's mockup).
// Without JavaScript the bar keeps those two, and the frame says the reader needs it.
import pdfjsUrl from 'pdfjs-dist/legacy/build/pdf.min.mjs?url';
import workerUrl from 'pdfjs-dist/legacy/build/pdf.worker.min.mjs?url';
import { PUBLIC_ONLY } from 'astro:env/server';
import CopyTag from '../../components/CopyTag.astro';
import Icon from '../../components/Icon.astro';
import Unavailable from '../../components/Unavailable.astro';
import { liveData } from '../../data';
import Base from '../../layouts/Base.astro';
import { attempt, markUnavailable } from '../../lib/api/page';
import { membersSignInLink, readerFor } from '../../lib/auth/bearer';
import { runtimeDeps } from '../../lib/auth/flow';
import { NOT_READY_TEXT } from '../../lib/files';
import { NEEDS_SCRIPT, readView } from '../../lib/reader';

export const prerender = false;

const auth = runtimeDeps();
const { reader } = readerFor(Astro.locals.session, auth);
const loaded = await attempt(() => readView(liveData(), Astro.params['id'], reader));
const view = loaded.ok ? loaded.value : undefined;
if (!loaded.ok) markUnavailable(Astro.response);
else if (view?.kind === 'not_found') Astro.response.status = 404;
else if (view?.kind === 'not_ready') {
  Astro.response.status = 503;
  Astro.response.headers.set('Retry-After', '60');
}
// As the file is served to a signed-in reader: never kept by a shared cache (the site policy keeps it so).
if (reader !== undefined) Astro.response.headers.set('Cache-Control', 'private, no-store');
const ok = view?.kind === 'ok' ? view : undefined;
const signIn = ok ? membersSignInLink(Astro.locals.session, auth, PUBLIC_ONLY, ok.read) : undefined;
const title = view?.kind === 'not_found' ? 'No such issue' : view?.kind === 'not_ready' ? 'Issue not ready yet' : 'Read the newsletter';
---
<Base path={Astro.url.pathname} title={title} description="An issue of Pensa Mensa, the newsletter of Northwest Florida Mensa, read on this site.">
  <h1>{title}</h1>
  {!loaded.ok && <Unavailable what="This issue" />}
  {view?.kind === 'not_found' && (
    <>
      <p>There is no issue at this address. It may have been moved or taken down.</p>
      <p class="btns"><a class="button" href="/news">Go to the News page</a></p>
    </>
  )}
  {view?.kind === 'not_ready' && <p>{NOT_READY_TEXT}</p>}
  {ok && (
    <>
      <CopyTag members={ok.copy === 'members'} signIn={signIn} />
      {/* W-LOOK3, Ross's mockup: ONE rounded thin frame whose top edge is the bar. Download and Open in
          another app are links, so the bar shows them without the script; the rest waits for it
          (data-viewer-js). READER2: |<< < [n] of N > >>| (the page typed in a plain text box), search,
          zoom (a picker, never a native select: WebKit's select breaks the site's CSP), Fit, Light pages
          where the theme recolours the pages, Download and Open. Every control has a spoken name
          (aria-label, which starts with any word shown) and a tooltip. Where a phone has no room, the later
          groups (data-ov) move into the More menu, which holds a copy of each (data-ov-item, data-viewer-act).
          The script measures the bar and moves only what would not fit on one row, in this order: Light
          pages, then Download and Open, then zoom, then Fit, then search. Page controls always stay. */}
      <section class="viewer" data-viewer data-pdf={ok.pdf} data-pdfjs={pdfjsUrl} data-worker={workerUrl} aria-labelledby="viewer-title">
        <h2 id="viewer-title" class="visually-hidden">The issue</h2>
        <div class="viewer-bar" data-viewer-bar>
          <div class="viewer-group viewer-group--pages" role="group" aria-label="Pages" data-viewer-js hidden>
            <button type="button" class="vbtn" data-viewer-first aria-label="First page" title="First page"><Icon name="first" /></button>
            <button type="button" class="vbtn" data-viewer-prev aria-label="Previous page" title="Previous page"><Icon name="back" /></button>
            <span class="vpage">
              <input class="vpage__box" id="viewer-page" data-viewer-page type="text" inputmode="numeric" pattern="[0-9]*" enterkeyhint="go" autocomplete="off" spellcheck="false" maxlength="5" value="1" aria-label="Page number" title="Page number: type one, then press Enter" />
              <span class="vpage__of" aria-hidden="true"><span class="vpage__word">of </span><span class="vpage__slash">/</span><span data-viewer-count></span></span>
            </span>
            <button type="button" class="vbtn" data-viewer-next aria-label="Next page" title="Next page"><Icon name="forward" /></button>
            <button type="button" class="vbtn" data-viewer-last aria-label="Last page" title="Last page"><Icon name="last" /></button>
          </div>
          <div class="viewer-group" data-ov="find" data-viewer-js hidden>
            <span class="viewer-sep" aria-hidden="true"></span>
            <button type="button" class="vbtn" data-viewer-find aria-expanded="false" aria-controls="viewer-find" aria-label="Search this issue" title="Search this issue (/)"><Icon name="search" /></button>
          </div>
          <div class="viewer-group" role="group" aria-label="Zoom" data-ov="zoom" data-viewer-js hidden>
            <span class="viewer-sep" aria-hidden="true"></span>
            <button type="button" class="vbtn vbtn--step" data-viewer-zoom-out aria-label="Zoom out" title="Zoom out"><Icon name="zoom-minus" /></button>
            <div class="vpick">
              <button type="button" class="vpick__btn" id="viewer-zoom" data-viewer-zoom aria-controls="viewer-zoom-list" title="Zoom">Zoom</button>
              <div class="vpick__list" id="viewer-zoom-list" data-viewer-zoom-list role="group" aria-label="Choose a zoom" hidden></div>
            </div>
            <button type="button" class="vbtn vbtn--step" data-viewer-zoom-in aria-label="Zoom in" title="Zoom in"><Icon name="zoom-plus" /></button>
            <button type="button" class="vbtn vbtn--hand" data-viewer-hand aria-pressed="false" aria-label="Hand tool: drag to move the page" title="Hand tool: drag to move the page"><Icon name="hand" /></button>
          </div>
          <div class="viewer-group" role="group" aria-label="Fit" data-ov="fit" data-viewer-js hidden>
            <span class="viewer-sep" aria-hidden="true"></span>
            <button type="button" class="vbtn vbtn--fit" data-viewer-fit-width aria-pressed="true" aria-label="Fit width" title="Fit width"><Icon name="fit-width" /><span class="vbtn__word">Fit width</span></button>
            <button type="button" class="vbtn vbtn--fit vbtn--fit-page" data-viewer-fit-page aria-pressed="false" aria-label="Fit page" title="Fit page"><Icon name="fit-page" /><span class="vbtn__word">Fit page</span></button>
          </div>
          <div class="viewer-group viewer-group--tone" data-ov="tone" data-viewer-js hidden>
            <span class="viewer-sep" aria-hidden="true"></span>
            <button type="button" class="vbtn" data-viewer-tone aria-pressed="false" aria-label="Light pages" title="Light pages: show the pages as printed"><Icon name="pages-light" /></button>
          </div>
          <div class="viewer-group" data-ov="file">
            <span class="viewer-sep viewer-sep--js" aria-hidden="true"></span>
            <a class="vbtn" href={ok.download} aria-label="Download" title="Download"><Icon name="download" /><span class="vbtn__word">Download</span></a>
          </div>
          <div class="viewer-group" data-ov="file">
            <span class="viewer-sep" aria-hidden="true"></span>
            <a class="vbtn" href={ok.pdf} target="_blank" rel="noopener" aria-label="Open in another app (opens the PDF file in a new tab, or in your PDF app)" title="Open in another app"><Icon name="external" /><span class="vbtn__word">Open in another app</span></a>
          </div>
          <div class="vpick vmore" data-viewer-js hidden>
            <button type="button" class="vbtn" id="viewer-more" data-viewer-more aria-controls="viewer-more-list" aria-label="More controls" title="More controls"><Icon name="dots" /></button>
            <div class="vpick__list vmore__list" id="viewer-more-list" data-viewer-more-list role="group" aria-label="More controls" hidden>
              <button type="button" class="vpick__choice vmore__item" data-ov-item="find" data-viewer-act="find" aria-expanded="false" aria-controls="viewer-find"><Icon name="search" />Search this issue</button>
              <button type="button" class="vpick__choice vmore__item" data-ov-item="fit" data-viewer-act="fit-width" aria-pressed="true"><Icon name="fit-width" />Fit width</button>
              <button type="button" class="vpick__choice vmore__item" data-ov-item="fit" data-viewer-act="fit-page" aria-pressed="false"><Icon name="fit-page" />Fit page</button>
              <p class="vmore__now vmore__item" data-ov-item="zoom" data-viewer-zoom-now>Zoom</p>
              <button type="button" class="vpick__choice vmore__item" data-ov-item="zoom" data-viewer-act="zoom-out"><Icon name="zoom-minus" />Zoom out</button>
              <button type="button" class="vpick__choice vmore__item" data-ov-item="zoom" data-viewer-act="zoom-in"><Icon name="zoom-plus" />Zoom in</button>
              <button type="button" class="vpick__choice vmore__item" data-ov-item="tone" data-viewer-act="tone" aria-pressed="false"><Icon name="pages-light" />Light pages</button>
              <a class="vpick__choice vmore__item" data-ov-item="file" href={ok.download}><Icon name="download" />Download</a>
              <a class="vpick__choice vmore__item" data-ov-item="file" href={ok.pdf} target="_blank" rel="noopener" aria-label="Open in another app (opens the PDF file in a new tab, or in your PDF app)"><Icon name="external" />Open in another app</a>
            </div>
          </div>
          <div class="viewer-find" id="viewer-find" data-viewer-find-bar role="search" aria-label="Search this issue" hidden>
            <input class="viewer-find__box" id="viewer-find-input" data-viewer-find-input type="text" enterkeyhint="search" autocomplete="off" spellcheck="false" aria-label="Search this issue" placeholder="Search this issue" title="Search this issue: Enter for the next match" aria-describedby="viewer-find-note" />
            <p class="viewer-find__count" data-viewer-find-count role="status"></p>
            <button type="button" class="vbtn" data-viewer-find-prev aria-label="Previous match" title="Previous match (Shift+Enter)"><Icon name="up" /></button>
            <button type="button" class="vbtn" data-viewer-find-next aria-label="Next match" title="Next match (Enter)"><Icon name="down" /></button>
            <button type="button" class="vbtn" data-viewer-find-close aria-label="Close search" title="Close search (Escape)"><Icon name="close" /></button>
            <p class="viewer-find__note" id="viewer-find-note" data-viewer-find-note role="status"></p>
          </div>
        </div>
        <p class="notice viewer-nojs" data-viewer-nojs>{NEEDS_SCRIPT}</p>
        <div class="viewer-body">
          <p class="viewer-status" role="status" data-viewer-status></p>
          <div class="viewer-pages" data-viewer-pages tabindex="0" role="region" aria-label="Pages of the issue" hidden></div>
          {/* Zoomed wider than the frame on a computer: a copy of the pages' scrollbar kept at the foot of
              the window (the pages scroll sideways by it, Shift and the wheel, a trackpad, the arrow keys
              on the focused pages, or the hand tool). */}
          <div class="viewer-pan" data-viewer-pan aria-hidden="true" hidden><div class="viewer-pan__track" data-viewer-pan-track></div></div>
        </div>
      </section>
      <script is:inline type="module" src="/scripts/viewer.js"></script>
    </>
  )}
</Base>
