---
import Base from '../layouts/Base.astro';
import { MORE_PAGES, page } from '../lib/site';

const p = page('/more');
---
<Base {...p}>
  <h1>{p.title}</h1>
  <p class="lead">{p.description}</p>
  <ul class="link-list">
    {MORE_PAGES.map((s) => <li><a href={s.path}>{s.title}</a></li>)}
  </ul>
</Base>
