---
// Events, the calendar (R4), on request: public events only. EVENTS2 (Ross's concept, 11-10): one
// toolbar ("‹ period ›" and List | Week | Month; EV1: on the heading's line where it fits, and compact
// where room is short), then the view, then its events as cards, the type
// legend and "Add our calendar" beneath. The view and the selected date live in the URL
// (?view=week&d=2026-11-11; the old ?month=YYYY-MM is that month's grid), so it works with no script
// and with Back; public/scripts/events.js only selects a day in place, swipes the week, copies the
// feed address and puts the Android steps first. List: the days with events in a scrolling ribbon,
// from today for eight weeks; Week: all seven days; Month: the grid, and the selected day's events
// right below it. With no API (the canary), or none in the range, it says that no events are listed
// yet, and who to ask.
import CalToolbar from '../components/CalToolbar.astro';
import DayTile from '../components/DayTile.astro';
import EmptyEvents from '../components/EmptyEvents.astro';
import EventCards from '../components/EventCards.astro';
import KindLegend from '../components/KindLegend.astro';
import MonthGrid from '../components/MonthGrid.astro';
import SubscribeCard from '../components/SubscribeCard.astro';
import Unavailable from '../components/Unavailable.astro';
import { liveData } from '../data';
import Base from '../layouts/Base.astro';
import { attempt, markUnavailable } from '../lib/api/page';
import { agendaDays, comingUp, dayAnchor, monthGrid, todayCentral } from '../lib/calendar';
import { calHref, calPeriod, feedLinks, parseCalState, ribbonDays, shortDay, weekDays } from '../lib/event-views';
import { feedWebcal } from '../lib/origin';
import { page } from '../lib/site';

const p = page('/events');
const live = liveData();
const now = new Date();
const today = todayCentral(now);
const state = parseCalState(Astro.url.searchParams, today);
if (state === undefined) return Astro.rewrite('/404');
const period = calPeriod(state, today);
const { view, date: selected } = state;
const links = feedLinks(feedWebcal(Astro.request, Astro.site));

const loaded = live ? await attempt(() => live.events(period.read.from, period.read.to, { categories: true })) : undefined;
if (loaded && !loaded.ok) markUnavailable(Astro.response);
const events = loaded?.ok ? loaded.value : [];
// The list from today leaves out what ended earlier today (W-LOOK2); a week or a month keeps it, as Past.
const shown = agendaDays((period.upcoming ? comingUp(events, now) : events).filter((e) => e.date >= period.from && e.date <= period.to)).flatMap((d) => d.events);
const days = agendaDays(shown);
const ribbon = view === 'list' ? ribbonDays(shown, today, selected) : [];
const week = view === 'week' ? weekDays(period.from, shown, today, selected) : [];
// EV1 round 3 (Ross's concept): under the cells, the heading line is the bare range ("Nov 29 – Dec 5"), or
// the list's words, in body text; the cards keep the fuller name.
const title = view === 'list' ? (period.upcoming ? 'Upcoming events' : period.thisPeriod ? `Events ${period.spoken}` : `Events in ${period.spoken}`) : view === 'week' ? period.label : shortDay(selected);
const cardsLabel = view === 'week' ? (period.thisPeriod ? `This week (${period.label})` : `Week of ${period.label}`) : title;
// Nothing to list: who to ask. The roster read failing only drops the address.
const roster = live && loaded?.ok && shown.length === 0 ? await attempt(() => live.offices()) : undefined;
const president = roster?.ok ? roster.value.find((o) => o.slug === 'president' && o.aliasVerified)?.alias : undefined;
const emptyWhen = period.upcoming ? 'for the next eight weeks' : view === 'list' && period.thisPeriod ? `${period.spoken} on` : `for ${period.spoken}`;
---
<Base {...p}>
  {live ? (
    loaded && !loaded.ok ? (
      <div class="calendar" data-cal={view}>
        <div class="calhead"><h1>{p.title}</h1><CalToolbar period={period} today={today} /></div>
        <Unavailable what="The calendar" />
        <SubscribeCard links={links} />
      </div>
    ) : (
      <div class="calendar" data-cal={view}>
        <div class="calhead"><h1>{p.title}</h1><CalToolbar period={period} today={today} /></div>
        {view === 'list' && ribbon.length > 0 && (
          <ol class="tiles tiles--ribbon" aria-label="Days with events">
            {ribbon.map((tile, i) => (
              <>
                {i > 0 && tile.month !== ribbon[i - 1]!.month && <li class="tiles__month" aria-hidden="true">{tile.month}</li>}
                <li><DayTile tile={tile} href={calHref('list', tile.date, today, `#${dayAnchor(tile.date)}`)} /></li>
              </>
            ))}
          </ol>
        )}
        {view === 'week' && (
          <ol class="tiles tiles--week" aria-label={`The days of ${period.spoken}`} data-swipe>
            {week.map((tile) => <li><DayTile tile={tile} href={calHref('week', tile.date, today, `#${dayAnchor(tile.date)}`)} /></li>)}
          </ol>
        )}
        {view === 'month' && <MonthGrid caption={period.label} weeks={monthGrid(period.from.slice(0, 7), shown, today)} selected={selected} today={today} />}
        {view === 'month' ? (
          <section class="agenda" aria-label="The selected day">
            {shown.length === 0 ? (
              <div class="daypanel" id={dayAnchor(selected)} data-panel={selected}>
                <div class="agenda__head"><h2>{shortDay(selected)}</h2><p class="tz">Central Time</p></div>
                <EmptyEvents when={emptyWhen} president={president} />
              </div>
            ) : (
              <>
                {!days.some((d) => d.date === selected) && (
                  <div class="daypanel" id={dayAnchor(selected)} data-panel={selected}>
                    <div class="agenda__head"><h2>{shortDay(selected)}</h2><p class="tz">Central Time</p></div>
                    <p class="card empty">No events on this day. The days with an icon have events.</p>
                  </div>
                )}
                {days.map((d) => (
                  <div class="daypanel" id={dayAnchor(d.date)} data-panel={d.date} hidden={d.date !== selected}>
                    <div class="agenda__head"><h2>{shortDay(d.date)}</h2><p class="tz">Central Time</p></div>
                    <EventCards events={d.events} label={`Events on ${shortDay(d.date)}`} />
                  </div>
                ))}
              </>
            )}
          </section>
        ) : (
          <section class="agenda" aria-labelledby="list-title">
            <div class="agenda__head"><h2 id="list-title" class="agenda__range">{title}</h2><p class="tz">Central Time</p></div>
            {shown.length > 0 ? (
              <>
                <EventCards events={shown} label={cardsLabel} selected={selected} anchors />
                {view === 'week' && <p class="card empty">No other events this week.</p>}
              </>
            ) : <EmptyEvents when={emptyWhen} president={president} />}
          </section>
        )}
        <p class="visually-hidden" role="status" data-cal-status></p>
        <SubscribeCard links={links} />
        <KindLegend />
      </div>
    )
  ) : (
    <>
      <h1>{p.title}</h1>
      <EmptyEvents />
    </>
  )}
  <script is:inline type="module" src="/scripts/events.js"></script>
</Base>
