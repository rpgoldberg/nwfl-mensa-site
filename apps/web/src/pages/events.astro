---
// Events, the calendar (R4), on request: public events only. This month as a
// grid and what is coming up as a list, or one month (?month=YYYY-MM) as both;
// a phone gets the list. The whole calendar as a subscription, and each
// event's page. With no API (the canary), or none in the range, it says that
// no events are listed yet, and who to ask.
import EmptyEvents from '../components/EmptyEvents.astro';
import EventList from '../components/EventList.astro';
import Icon from '../components/Icon.astro';
import MonthGrid from '../components/MonthGrid.astro';
import Unavailable from '../components/Unavailable.astro';
import { liveData } from '../data';
import Base from '../layouts/Base.astro';
import { attempt, markUnavailable } from '../lib/api/page';
import { calendarRange, googleCalendarUrl, monthGrid, monthLabel, shiftMonth, todayCentral } from '../lib/calendar';
import { page } from '../lib/site';

const p = page('/events');
const live = liveData();
const today = todayCentral(new Date());
const feedUrl = `webcal://${Astro.url.host}/calendar.ics`;
const range = calendarRange(Astro.url.searchParams.get('month'), today);
if (range === undefined) return Astro.rewrite('/404');

const loaded = live ? await attempt(() => live.events(range.read.from, range.read.to)) : undefined;
if (loaded && !loaded.ok) markUnavailable(Astro.response);
const events = loaded?.ok ? loaded.value : [];
const listed = events.filter((e) => e.date >= range.list.from && e.date <= range.list.to);
const label = monthLabel(range.month);
const [previous, next] = [shiftMonth(range.month, -1), shiftMonth(range.month, 1)];
const listTitle = range.current ? 'Coming up' : `${label}, as a list`;
// Nothing to list: who to ask. The roster read failing only drops the address.
const roster = live && loaded?.ok && listed.length === 0 ? await attempt(() => live.offices()) : undefined;
const president = roster?.ok ? roster.value.find((o) => o.slug === 'president' && o.aliasVerified)?.alias : undefined;
---
<Base {...p}>
  <h1>{p.title}</h1>
  <p class="lead">{p.description}</p>
  {live ? (
    <>
      <p>All times are Central. Choose an event for the place and who to ask.</p>
      <section class="card" aria-labelledby="subscribe-title">
        <h2 id="subscribe-title">Add our calendar to your phone</h2>
        <p>Your phone's calendar then shows our public events, and keeps them up to date by itself.</p>
        <p class="btns">
          <a class="button" href={feedUrl}><Icon name="add-calendar" />Add our calendar</a>
          <a class="button" href={googleCalendarUrl(feedUrl)}><Icon name="add-calendar" />Add to Google Calendar</a>
          <a class="button button--secondary" href="/calendar.ics"><Icon name="download" />Download the calendar file</a>
        </p>
        <p class="muted">On an iPhone, iPad and Mac, "Add our calendar" subscribes and keeps itself up to date. On Android or Google Calendar, use "Add to Google Calendar"; Google refreshes it every few hours, and the free app ICSx⁵ also works. "Download the calendar file" copies today's events once and won't update.</p>
      </section>
      {loaded && !loaded.ok ? <Unavailable what="The calendar" /> : (
        <div class="calendar">
          <nav class="month-nav" aria-label="Months">
            <a class="hbtn" href={`/events?month=${previous}`}><Icon name="back" />{monthLabel(previous)}</a>
            {!range.current && <a class="hbtn" href="/events">This month</a>}
            <a class="hbtn" href={`/events?month=${next}`}>{monthLabel(next)}<Icon name="forward" /></a>
          </nav>
          <div class="calgrid">
            <section class="monthbox" aria-label={`${label}, as a grid`}>
              <MonthGrid caption={label} weeks={monthGrid(range.month, events, today)} />
            </section>
            <section class="agenda" aria-labelledby="list-title">
              <h2 id="list-title">{listTitle}</h2>
              {listed.length > 0 ? <EventList events={listed} label={listTitle} /> : <EmptyEvents when={range.current ? 'for the next eight weeks' : `for ${label}`} president={president} />}
            </section>
          </div>
        </div>
      )}
    </>
  ) : <EmptyEvents />}
</Base>
