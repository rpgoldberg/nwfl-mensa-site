---
// Events, the calendar (R4), on request: public events only. This month as a
// grid and what is coming up as a list, or one month (?month=YYYY-MM) as both;
// the grid, then the subscription card, then the list (W-LOOK2: a phone sees the calendar first), and
// W-LOOK3: the month arrows sit in the grid's caption row, and the subscription is one disclosure; and
// each event's page. With no API (the canary), or none in the range, it says that no events are
// listed yet, and who to ask.
import EmptyEvents from '../components/EmptyEvents.astro';
import EventList from '../components/EventList.astro';
import Icon from '../components/Icon.astro';
import MonthGrid from '../components/MonthGrid.astro';
import SubscribeCard from '../components/SubscribeCard.astro';
import Unavailable from '../components/Unavailable.astro';
import { liveData } from '../data';
import Base from '../layouts/Base.astro';
import { attempt, markUnavailable } from '../lib/api/page';
import { calendarRange, comingUp, monthGrid, monthLabel, shiftMonth, todayCentral } from '../lib/calendar';
import { feedWebcal } from '../lib/origin';
import { page } from '../lib/site';

const p = page('/events');
const live = liveData();
const now = new Date();
const today = todayCentral(now);
const feedUrl = feedWebcal(Astro.request, Astro.site);
const range = calendarRange(Astro.url.searchParams.get('month'), today);
if (range === undefined) return Astro.rewrite('/404');

const loaded = live ? await attempt(() => live.events(range.read.from, range.read.to)) : undefined;
if (loaded && !loaded.ok) markUnavailable(Astro.response);
const events = loaded?.ok ? loaded.value : [];
// W-LOOK2: "Coming up" leaves out what ended earlier today; a month's list keeps it, as Past.
const listed = (range.current ? comingUp(events, now) : events).filter((e) => e.date >= range.list.from && e.date <= range.list.to);
const listedDays = new Set(listed.map((e) => e.date));
const label = monthLabel(range.month);
const [previous, next] = [shiftMonth(range.month, -1), shiftMonth(range.month, 1)];
/** "October" of "October 2026": the year is spoken, not shown, beside the arrows. */
const monthWord = (month: string) => monthLabel(month).replace(/ \d{4}$/, '');
const listTitle = range.current ? 'Coming up' : `${label}, as a list`;
// Nothing to list: who to ask. The roster read failing only drops the address.
const roster = live && loaded?.ok && listed.length === 0 ? await attempt(() => live.offices()) : undefined;
const president = roster?.ok ? roster.value.find((o) => o.slug === 'president' && o.aliasVerified)?.alias : undefined;
---
<Base {...p}>
  <h1>{p.title}</h1>
  <p class="lead">{p.description} All times are Central.</p>
  {live ? (
    <>
      {loaded && !loaded.ok ? <><SubscribeCard feedUrl={feedUrl} /><Unavailable what="The calendar" /></> : (
        <div class="calendar">
          <div class="calgrid">
            <section class="monthbox" aria-label={`${label}, as a grid`}>
              {/* The grid's caption row: "‹ October" | the month | "December ›". The table's own caption
                  names it for a screen reader, so the month here is for the eye only. */}
              <div class="month-head">
                <nav class="month-nav" aria-label="Months">
                  <a class="mnav mnav--prev" href={`/events?month=${previous}`}><Icon name="back" />{monthWord(previous)}<span class="visually-hidden"> {previous.slice(0, 4)}</span></a>
                  <p class="month-title"><span aria-hidden="true">{label}</span>{!range.current && <a href="/events">This month</a>}</p>
                  <a class="mnav mnav--next" href={`/events?month=${next}`}>{monthWord(next)}<span class="visually-hidden"> {next.slice(0, 4)}</span><Icon name="forward" /></a>
                </nav>
              </div>
              <MonthGrid caption={label} weeks={monthGrid(range.month, events, today)} listed={listedDays} />
            </section>
            <SubscribeCard feedUrl={feedUrl} />
            <section class="agenda" aria-labelledby="list-title">
              <h2 id="list-title">{listTitle}</h2>
              {listed.length > 0 ? <EventList events={listed} label={listTitle} anchors /> : <EmptyEvents when={range.current ? 'for the next eight weeks' : `for ${label}`} president={president} />}
            </section>
          </div>
        </div>
      )}
    </>
  ) : <EmptyEvents />}
</Base>
