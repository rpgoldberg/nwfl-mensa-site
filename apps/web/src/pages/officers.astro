---
// The roster by office (R2), on request: from the API when it is set (W3), the
// bundled sample otherwise. Every holder of a seat that has several (two
// Members at Large) is listed. Role addresses only, and only once mail to
// them has been seen to arrive; a vacant seat says so.
import { PUBLIC_ONLY } from 'astro:env/server';
import Address from '../components/Address.astro';
import PublicOnlyNote from '../components/PublicOnlyNote.astro';
import SampleNotice from '../components/SampleNotice.astro';
import Unavailable from '../components/Unavailable.astro';
import { liveData, siteData } from '../data';
import { rosterView } from '../data/site-data';
import Base from '../layouts/Base.astro';
import { attempt, markUnavailable } from '../lib/api/page';
import { visibleContent } from '../lib/content';
import { page } from '../lib/site';

const p = page('/officers');
const live = liveData();
const loaded = live ? await attempt(() => live.offices()) : { ok: true as const, value: await siteData.offices() };
if (!loaded.ok) markUnavailable(Astro.response);
const roster = rosterView(visibleContent(loaded.ok ? loaded.value : [], { publicOnly: PUBLIC_ONLY }));
const president = roster.find((o) => o.slug === 'president')?.email;
---
<Base {...p}>
  <h1>{p.title}</h1>
  <p class="lead">{p.description}</p>
  {!live && siteData.isSample && <SampleNotice />}
  {PUBLIC_ONLY ? <PublicOnlyNote what="The officer list" /> : !loaded.ok ? <Unavailable what="The officer list" /> : (
    <ul class="offices" aria-label="Officers">
      {roster.map((o) => (
        <li data-source={o.source}>
          <span class="role">{o.title}</span>
          {o.vacant
            ? <span>Vacant. Interested? {president ? <>Write to <Address email={president} />.</> : <>Ask any officer.</>}</span>
            : o.holders.map((holder) => <span class="holder">{holder}</span>)}
          {!o.vacant && o.email && <Address class="addr" email={o.email} />}
        </li>
      ))}
    </ul>
  )}
</Base>
