---
// An item's PDFs (REDACT R3c), each a plain link that opens the file; a members
// file, in a member's view only, says it is the members copy (A14).
import type { FileLink } from '../data/live';

interface Props {
  files: readonly FileLink[];
}
const { files } = Astro.props;
---
{files.length > 0 && (
  <ul class="item-files">
    {files.map((f) => <li><a href={f.href}>{f.members ? `${f.label} (members copy, PDF)` : `${f.label} (PDF)`}</a></li>)}
  </ul>
)}
