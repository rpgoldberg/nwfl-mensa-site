---
// EVENTS2: an event's type as a drawn icon (Ross's concept): utensils for a meal, a mug for a happy
// hour or party, people for a meetup or gathering, a calendar with an agenda for a meeting or anything
// else, and the plain calendar for an event the API gives no category (lib/event-views.ts eventKind).
// A cancelled one is struck through, and its name says so. `named`: an image with its name (on a
// card); otherwise decorative, its name in the link or tile around it.
import { type EventKind, KIND_LABELS } from '../lib/event-views';

interface Props {
  kind: EventKind;
  cancelled?: boolean;
  named?: boolean;
}
const { kind, cancelled = false, named = false } = Astro.props;
const name = cancelled ? `${KIND_LABELS[kind]}, cancelled` : KIND_LABELS[kind];
---
<svg
  class:list={['evicon', `evicon--${kind}`, { 'evicon--x': cancelled }]}
  viewBox="0 0 24 24"
  width="24"
  height="24"
  focusable="false"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  {...(named ? { role: 'img', 'aria-label': name } : { 'aria-hidden': 'true' })}
>
  {named && <title>{name}</title>}
  {kind === 'meal' && <path d="M6 3v6a2 2 0 0 0 4 0V3M8 3v18M17 21V3c-2.2 1.4-3.2 4-3.2 7.5V14H17" />}
  {kind === 'social' && <><path d="M5 7h11v10a3 3 0 0 1-3 3H8a3 3 0 0 1-3-3z" /><path d="M16 9.5h1.5a2.5 2.5 0 0 1 0 5H16M8.5 10v6M12.5 10v6" /></>}
  {kind === 'gathering' && <><circle cx="12" cy="7.5" r="2.8" /><path d="M6.5 20c.6-3.2 2.8-5 5.5-5s4.9 1.8 5.5 5" /><circle cx="5" cy="10" r="2" /><path d="M1.8 18.5c.4-2 1.6-3.3 3.4-3.6" /><circle cx="19" cy="10" r="2" /><path d="M22.2 18.5c-.4-2-1.6-3.3-3.4-3.6" /></>}
  {kind === 'meeting' && <><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 10h18M8 3v4M16 3v4M7 14h10M7 17.5h6" /></>}
  {kind === 'event' && <><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 10h18M8 3v4M16 3v4" /></>}
  {cancelled && <path class="evicon__x" d="M3 3l18 18" />}
</svg>
