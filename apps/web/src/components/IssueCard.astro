---
// The newsletter's card, after the design draft: a drawn cover, the issue and
// what to do with it. A live issue leads to its public PDF, and in a member's
// view of /news to its members copy too, with the line not to forward it (A14).
// Until the archive is real (MB3, C1) Home's card names no issue and leads to
// every issue we can share. PDFVIEW: "Read this issue" and "Members copy" open the issue in
// the site (/read/<id>); a small "PDF file" link beside each keeps the file itself. By the public
// button, the notice that it is the public copy (CopyNotice), with "sign in" a link where sign-in
// works (membersSignIn); a member's view has its members copy instead. On /news only.
import { type Issue, issueSummary } from '../data/site-data';
import { MEMBERS_RULE } from '../lib/document';
import { readerPath } from '../lib/reader';
import CopyNotice from './CopyNotice.astro';
import Icon from './Icon.astro';

interface Props {
  issue: Issue | undefined;
  /** On Home: the newsletter's own name leads, and the button goes to its page. */
  home?: boolean;
  /** Where the notice's "sign in" leads, for a reader not signed in (/news, where sign-in works). Never on Home. */
  membersSignIn?: string | undefined;
}
const { issue, home = false, membersSignIn } = Astro.props;
const summary = issue ? issueSummary(issue) : '';
---
<section class="card issue" aria-labelledby="issue-title" data-source={issue?.source}>
  <div class="cover" aria-hidden="true"><b>Pensa Mensa</b><i></i><i></i><i></i><i></i><i></i></div>
  <div class="issue-text">
    <p class="eyebrow">{home ? 'The newsletter' : 'Current issue'}</p>
    <h2 id="issue-title">{issue ? (home ? `Pensa Mensa for ${issue.label}` : issue.label) : 'Pensa Mensa'}</h2>
    {summary && <p class="muted">{summary}</p>}
    {!home && !issue?.pdf && <p>Large-type reading and the PDF arrive with the archive.</p>}
  </div>
  {home && <p class="btns"><a class="button button--secondary" href="/news"><Icon name="newsletter" />See every issue</a></p>}
  {!home && issue?.pdf && (
    <>
      <p class="btns">
        <a class="button" href={readerPath(issue.pdf)}><Icon name="doc" />Read this issue</a>
        {issue.membersPdf && <a class="button button--secondary" href={readerPath(issue.membersPdf)}><Icon name="lock" />Members copy</a>}
      </p>
      <p class="pdf-files">
        <a href={issue.pdf}>PDF file<span class="visually-hidden"> of this issue</span></a>
        {issue.membersPdf && <a href={issue.membersPdf}>Members PDF file<span class="visually-hidden"> of this issue</span></a>}
      </p>
      {issue.membersPdf ? <p class="members-rule">{MEMBERS_RULE}</p> : <CopyNotice signIn={membersSignIn} />}
    </>
  )}
</section>
