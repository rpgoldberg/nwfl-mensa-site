---
// EVENTS2: "Add our calendar", one compact disclosure beneath the listings, closed at first (Ross's
// concept). The plain feed address with Copy, labelled for calendar apps, so the Google link is never
// taken for the feed (Ross's ICSx⁵ test); the webcal link, which ICSx⁵ opens on Android; Google
// Calendar on a computer; and, for an Android phone, Google's own From-URL page in Chrome's Desktop
// site mode, then Sync on. On Android, public/scripts/events.js puts those steps first and hides the
// computer-only Google link. Every address carries the feed version (?v=N, event-views.ts).
import Icon from './Icon.astro';
import type { FeedLinks } from '../lib/event-views';
import { SITE_NAME } from '../lib/site';

interface Props {
  links: FeedLinks;
}
const { links } = Astro.props;
---
<details class="addcal">
  <summary class="addcal__sum"><Icon name="add-calendar" /><span>Add our calendar</span></summary>
  <div class="addcal__panel" data-addcal-panel>
    <div class="addcal__addr">
      <label for="feed-address">Calendar address (for calendar apps)</label>
      <div class="addcal__copy">
        <input id="feed-address" type="text" readonly value={links.address} spellcheck="false" autocomplete="off" />
        <button type="button" class="button button--secondary" data-copy="feed-address" data-copy-status="feed-copied" hidden>Copy</button>
      </div>
      <p class="addcal__status" id="feed-copied" role="status"></p>
    </div>
    <p class="addcal__way"><a href={links.webcal}><Icon name="add-calendar" />Open in a calendar app (Android: ICSx⁵)</a></p>
    <p class="addcal__way" data-not-android><a href={links.google}><Icon name="external" />Google Calendar on a computer</a></p>
    <section class="addcal__android" data-android aria-labelledby="android-title">
      <h3 id="android-title">Google Calendar on an Android phone</h3>
      <ol>
        <li>Tap Copy beside the calendar address.</li>
        <li>In Chrome, open <a href={links.addByUrl}>Google Calendar's Add by URL page</a>.</li>
        <li>Tap <span class="kbd">⋮</span> › Desktop site first, if it shows the phone page.</li>
        <li>Paste the address, then tap Add calendar.</li>
        <li>In the Calendar app: Settings › {SITE_NAME} › Sync on.</li>
      </ol>
      <p>Or install the free ICSx⁵ app (Play Store or F-Droid), then tap Open in a calendar app.</p>
    </section>
    <p class="muted">On an iPhone, iPad or Mac, Open in a calendar app subscribes, and keeps itself up to date. For one event, open it and add just that one. <a href="/calendar.ics">Download the calendar file</a> copies today's events once and won't update.</p>
  </div>
</details>
