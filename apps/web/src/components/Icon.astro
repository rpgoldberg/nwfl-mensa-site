---
// Line icons from the design draft. Decorative: every icon sits beside its word, or in a control
// whose spoken name and tooltip give the word (W-LOOK3's reader bar).
import type { MoreIcon, NavIcon } from '../lib/site';

export type IconName = NavIcon | MoreIcon | 'theme' | 'add-calendar' | 'download' | 'external' | 'pin' | 'lock' | 'back' | 'forward' | 'search' | 'zoom-in' | 'zoom-out' | 'zoom-minus' | 'zoom-plus' | 'fit-width' | 'fit-page';

interface Props {
  name: IconName;
}
const { name } = Astro.props;
---
<svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
  {name === 'home' && <><path d="M3 11l9-7 9 7" /><path d="M5 10v10h5v-6h4v6h5V10" /></>}
  {name === 'calendar' && <><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 10h18M8 3v4M16 3v4" /></>}
  {name === 'add-calendar' && <><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 10h18M8 3v4M16 3v4M12 13v6M9 16h6" /></>}
  {name === 'newsletter' && <><path d="M5 3h11l3 3v15H5z" /><path d="M8 9h8M8 13h8M8 17h5" /></>}
  {name === 'search' && <><circle cx="11" cy="11" r="6.5" /><path d="m16 16 5 5" /></>}
  {name === 'more' && <path d="M4 6h16M4 12h16M4 18h16" />}
  {name === 'theme' && <><circle cx="12" cy="12" r="8" /><path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor" /></>}
  {name === 'download' && <path d="M12 4v11M7 10l5 5 5-5M5 20h14" />}
  {name === 'external' && <path d="M14 4h6v6M20 4l-9 9M18 14v6H4V6h6" />}
  {name === 'pin' && <><path d="M12 21s-7-6-7-11a7 7 0 0 1 14 0c0 5-7 11-7 11z" /><circle cx="12" cy="10" r="2.5" /></>}
  {name === 'lock' && <><rect x="5" y="11" width="14" height="10" rx="2" /><path d="M8 11V8a4 4 0 0 1 8 0v3" /></>}
  {name === 'back' && <path d="M15 5 8 12l7 7" />}
  {name === 'forward' && <path d="m9 5 7 7-7 7" />}
  {name === 'zoom-out' && <><circle cx="10.5" cy="10.5" r="6.5" /><path d="m15.5 15.5 5.5 5.5M7.5 10.5h6" /></>}
  {name === 'zoom-in' && <><circle cx="10.5" cy="10.5" r="6.5" /><path d="m15.5 15.5 5.5 5.5M7.5 10.5h6M10.5 7.5v6" /></>}
  {name === 'zoom-minus' && <><circle cx="12" cy="12" r="9" /><path d="M8 12h8" /></>}
  {name === 'zoom-plus' && <><circle cx="12" cy="12" r="9" /><path d="M8 12h8M12 8v8" /></>}
  {name === 'fit-width' && <path d="M3 5v14M21 5v14M6 12h12M9 9l-3 3 3 3M15 9l3 3-3 3" />}
  {name === 'fit-page' && <><path d="M3 8V3h5M16 3h5v5M21 16v5h-5M8 21H3v-5" /><rect x="8" y="7" width="8" height="10" rx="1" /></>}
  {name === 'info' && <><circle cx="12" cy="12" r="9" /><path d="M12 11v6M12 7.5v.01" /></>}
  {name === 'users' && <><circle cx="9" cy="8" r="3.2" /><path d="M3 19c.8-3.2 3.2-5 6-5s5.2 1.8 6 5" /><circle cx="17" cy="9" r="2.5" /><path d="M16 14c2.4 0 4.3 1.6 5 4.5" /></>}
  {name === 'scale' && <path d="M12 4v16M7 20h10M5 8h14M5 8l-3 6a3 3 0 0 0 6 0zM19 8l-3 6a3 3 0 0 0 6 0z" />}
  {name === 'doc' && <><path d="M7 3h7l4 4v14H7z" /><path d="M14 3v4h4M10 12h6M10 16h6" /></>}
  {name === 'coin' && <><circle cx="12" cy="12" r="9" /><path d="M14.5 9.5c-.5-1-1.5-1.5-2.5-1.5-1.5 0-2.5.8-2.5 2s1 1.6 2.5 2 2.5.8 2.5 2-1 2-2.5 2c-1 0-2-.5-2.5-1.5M12 6.5v1.5M12 16v1.5" /></>}
  {name === 'join' && <><circle cx="10" cy="8" r="3.5" /><path d="M3 20c.8-3.6 3.6-5.5 7-5.5 1.3 0 2.5.3 3.5.8M18 14v6M15 17h6" /></>}
  {name === 'help' && <><circle cx="12" cy="12" r="9" /><path d="M9.5 9.5a2.5 2.5 0 1 1 3.5 2.3c-.6.3-1 .9-1 1.6v.6M12 17v.01" /></>}
  {name === 'mail' && <><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 7l9 6 9-6" /></>}
  {name === 'phone' && <><rect x="7" y="2.5" width="10" height="19" rx="2" /><path d="M11 18.5h2" /></>}
</svg>
