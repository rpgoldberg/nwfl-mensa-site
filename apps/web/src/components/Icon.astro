---
// Line icons from the design draft. Decorative: every icon sits beside its word.
import type { NavIcon } from '../lib/site';

interface Props {
  name: NavIcon | 'theme';
}
const { name } = Astro.props;
---
<svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
  {name === 'home' && <><path d="M3 11l9-7 9 7" /><path d="M5 10v10h5v-6h4v6h5V10" /></>}
  {name === 'calendar' && <><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 10h18M8 3v4M16 3v4" /></>}
  {name === 'newsletter' && <><path d="M5 3h11l3 3v15H5z" /><path d="M8 9h8M8 13h8M8 17h5" /></>}
  {name === 'search' && <><circle cx="11" cy="11" r="6.5" /><path d="m16 16 5 5" /></>}
  {name === 'more' && <path d="M4 6h16M4 12h16M4 18h16" />}
  {name === 'theme' && <><circle cx="12" cy="12" r="8" /><path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor" /></>}
</svg>
