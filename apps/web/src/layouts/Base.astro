---
// The frame of every page, after the design draft: skip link; header with the
// site name as text over the teal-and-sand stripe, the wide-screen nav, Aa,
// Help and Sign in; the Aa panel; breadcrumbs and Back; the footer; the
// reading bar on long reads; and the phone's bottom bar. No script: Aa opens its
// panel as a link target, and the reader's size and theme come from cookies.
import '@fontsource/atkinson-hyperlegible/400.css';
import '@fontsource/atkinson-hyperlegible/400-italic.css';
import '@fontsource/atkinson-hyperlegible/700.css';
import '@fontsource/lexend/500.css';
import '@fontsource/lexend/600.css';
import '../styles/tokens.css';
import '../styles/site.css';
import { PUBLIC_ONLY } from 'astro:env/server';
import { htmlAttributes, readPrefs } from '../../server/prefs.mjs';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import PrimaryNav from '../components/PrimaryNav.astro';
import ReaderControls from '../components/ReaderControls.astro';
import ReadingBar from '../components/ReadingBar.astro';
import { SITE_NAME, trailFor } from '../lib/site';

interface Props {
  path: string;
  title: string;
  description: string;
  reading?: boolean | undefined;
}
const { path, title, description, reading = false } = Astro.props;
const trail = trailFor(path, title);
const documentTitle = path === '/' ? SITE_NAME : `${title} | ${SITE_NAME}`;
// A prerendered page is built with the defaults; the server wrapper stamps the
// reader's settings on its <html> tag when it serves the file.
const attrs = htmlAttributes(readPrefs(Astro.isPrerendered ? undefined : Astro.request.headers.get('cookie')));
const back = Astro.isPrerendered ? path : `${Astro.url.pathname}${Astro.url.search}`;
---
<!doctype html>
<html lang="en" data-size={attrs['data-size']} data-theme={attrs['data-theme']}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/icon-32.png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="theme-color" content="#00566b" />
    <meta name="apple-mobile-web-app-title" content="NWFL Mensa" />
    {/* Progressive enhancement only (install button, in-app browser hint); a same-origin file, never inline. */}
    <script is:inline type="module" src="/scripts/install.js"></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <header class="site-header">
      <div class="site-header__bar">
        <a class="wordmark" href="/"><span class="wordmark__place">Northwest Florida</span> <span class="wordmark__name">Mensa</span></a>
        <PrimaryNav path={path} variant="top" />
        <div class="header-tools">
          <a class="hbtn" id="reader-toggle" href="#reader-menu"><Icon name="theme" />Aa<span class="visually-hidden"> Text size and theme</span></a>
          <a class="hbtn" href="/help">Help</a>
          {!PUBLIC_ONLY && <a class="hbtn hbtn--primary" href="/sign-in">Sign in</a>}
        </div>
      </div>
      <div class="horizon" aria-hidden="true"></div>
    </header>
    <div class="in-app-hint" role="note" aria-labelledby="in-app-hint-title" data-in-app-hint hidden>
      <p><b id="in-app-hint-title">Open in your browser</b> You are reading this inside Facebook or Instagram, which cannot put the club on your home screen. Tap ⋯ or ⋮ at the top, then <b>Open in browser</b>.</p>
      <button type="button" class="hbtn" data-in-app-hint-close>Close this hint</button>
    </div>
    <section class="reader-panel" id="reader-menu" aria-labelledby="reader-menu-title" tabindex="-1">
      <h2 id="reader-menu-title">Text size and theme</h2>
      <ReaderControls back={back} />
      <p class="muted">Saved on this device. No account needed.</p>
      <p>Your browser's zoom works too: spread two fingers on a phone or tablet, or hold Ctrl (⌘ on a Mac) and press + on a computer.</p>
      <a class="button" href="#reader-toggle">Done</a>
    </section>
    <div class="page">
      <Breadcrumbs trail={trail} />
      <main id="main" tabindex="-1">
        <slot />
      </main>
    </div>
    <footer class="site-footer">
      <p><a href="/home-screen">Put the club on your home screen</a></p>
      <p>{SITE_NAME} is the local group of American Mensa for the Florida Panhandle, west of the Apalachicola River.</p>
    </footer>
    <div class="dock">
      {reading && <ReadingBar back={back} />}
      <PrimaryNav path={path} variant="bottom" />
    </div>
  </body>
</html>
